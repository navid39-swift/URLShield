          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospetto"
          }
        }
      }
    },
    "Swipe the row of apps to the end and tap More." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri la fila di app fino in fondo e tocca Altro."
          }
        }
      }
    },
    "Tap “Text Message Filter” and choose URLShield." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca “Filtro messaggi di testo” e scegli URLShield."
