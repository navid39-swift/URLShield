    "No red flags found" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun segnale di pericolo"
          }
        }
      }
    },
    "No tool can guarantee that a link is safe. Hacked websites and brand-new tricks can look normal. When in doubt, contact the company through its official app or website." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno strumento può garantire che un link sia sicuro. Siti violati e trucchi nuovi possono sembrare normali. Nel dubbio, contatta l'azienda tramite la sua app o il suo sito ufficiale."
          }
        }
      }
    },
    "Not quite." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non proprio."
          }
        }
      }
    },
