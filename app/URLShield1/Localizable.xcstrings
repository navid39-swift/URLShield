      }
    },
    "Looks very similar to “%@”, a common trick called typosquatting." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assomiglia molto a “%@”: un trucco comune chiamato typosquatting."
          }
