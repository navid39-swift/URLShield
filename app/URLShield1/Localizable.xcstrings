            "value" : "Impossibile caricare il modello di rilevamento."
          }
        }
      }
    },
    "The ending was changed to an unusual, cheap one." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte finale è stata cambiata con una insolita ed economica."
          }
        }
      }
    },
    "The model" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
