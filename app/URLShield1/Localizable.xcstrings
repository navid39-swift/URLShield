        }
      }
    },
    "How it works" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come funziona"
          }
        }
      }
    },
    "In any app, tap Share (or long-press a link, then Share)." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In qualsiasi app, tocca Condividi (o tieni premuto un link, poi Condividi)."
