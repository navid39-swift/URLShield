          }
        }
      }
    },
    "The model is up to date." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello è aggiornato."
          }
        }
      }
    },
    "The real one is %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello vero è %@."
          }
        }
      }
    },
    "The update could not be verified or downloaded. Try again later." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare o verificare l'aggiornamento. Riprova più tardi."
          }
        }
      }
    },
    "This is a shortened link. Its real destination can't be seen without opening it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è un link accorciato. La sua vera destinazione non si può vedere senza aprirlo."
          }
        }
      }
    },
    "This is the official domain of a well-known website. Check that the domain below is exactly the one you expect." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è il dominio ufficiale di un sito noto. Controlla che il dominio qui sotto sia esattamente quello che ti aspetti."
          }
        }
      }
    },
    "This text doesn't contain any web links." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo testo non contiene link web."
          }
        }
      }
    },
    "Trained on 800,484 web addresses from three public sources: the PhiUSIIL research dataset (UCI, CC BY 4.0), Phishing.Database (© Mitchell Krog, MIT License) and the Tranco list of popular sites. On websites it had never seen, when it is very sure it catches about 6 phishing sites in 10, with about 1 false alarm per 1,000 normal sites." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addestrato su 800.484 indirizzi web da tre fonti pubbliche: il dataset di ricerca PhiUSIIL (UCI, CC BY 4.0), Phishing.Database (© Mitchell Krog, licenza MIT) e la lista Tranco dei siti più popolari. Su siti mai visti prima, quando è molto sicuro riconosce circa 6 siti di phishing su 10, con circa 1 falso allarme ogni 1.000 siti normali."
          }
        }
      }
    },
    "Turn on URLShield, then tap Done." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva URLShield, poi tocca Fine."
          }
        }
      }
    },
    "Turn on “Screen Unknown Senders”." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva “Filtra mittenti sconosciuti”."
          }
        }
      }
    },
    "URLShield" : {
      "shouldTranslate" : false
    },
    "URLShield finds every link and checks its real domain." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLShield trova ogni link e ne controlla il vero dominio."
          }
        }
      }
    },
    "Updates are only downloaded and verified on your iPhone. Nothing is uploaded." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti vengono solo scaricati e verificati sul tuo iPhone. Non viene inviato nulla."
          }
        }
      }
    },
    "Uses a raw IP address instead of a website name." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un indirizzo IP invece del nome di un sito."
          }
        }
      }
    },
    "Uses special characters that can imitate normal letters." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa caratteri speciali che possono imitare lettere normali."
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione"
          }
        }
      }
    },
    "We found no warning signs, but no tool can guarantee that a link is safe." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato segnali di pericolo, ma nessuno strumento può garantire che un link sia sicuro."
          }
        }
      }
    },
    "Which one is the real website?" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual è il sito vero?"
          }
        }
      }
    },
    "Works only for senders who are not in your contacts. Screening also moves messages from unknown senders to a separate list in Messages." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona solo per i mittenti che non sono nei tuoi contatti. Il filtro sposta anche i messaggi dei mittenti sconosciuti in un elenco separato in Messaggi."
          }
        }
      }
    },
    "You copied a link" : {
      "localizations" : {
        "it" : {
